# Port, unter dem die App im Browser erreichbar ist
WEB_PORT=8099

# Beim ersten Start die Positionen aus der Excel als Startdaten anlegen
SEED_ON_START=true

# Automatische Snapshots (0 schaltet sie ab)
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# --- Barcode-Scanner ---------------------------------------------------
# Alles hier lässt sich auch unter Einstellungen → "Scanner & KI" setzen.
# Was hier steht, hat Vorrang und ist in der Oberfläche gesperrt - eine
# bewusste Vorgabe soll nicht still aus dem Browser überschrieben werden.
# Wer lieber im Dashboard konfiguriert, lässt die Zeilen einfach leer.

# Gemeinsames Geheimnis für POST /api/scan-events. Leer = offen wie der Rest
# der App; gesetzt = die Scanner-Station muss es als Bearer-Token mitschicken.
# Ein Gerät, das von außen schreibt, sollte eins haben.
SCAN_TOKEN=

# Unbekannte EANs in den offenen Facts-Datenbanken nachschlagen
# (Lebensmittel, Haushalt, Drogerie, Tiernahrung). Dabei verlässt die EAN das
# Haus - false hält alles lokal, dann werden neue Codes von Hand benannt.
PRODUCT_LOOKUP=true

# Optionaler KI-Schritt: räumt die Rohdaten auf und ordnet sie einem
# vorhandenen Artikel zu. Ohne Key bleibt alles wie vorher, nur ohne
# Vorbelegung im Scan-Eingang.
ANTHROPIC_API_KEY=
AI_RESOLVER=true
AI_MODEL=claude-opus-5
# Ab dieser Sicherheit (0-1) wird ohne Rückfrage gebucht
AI_AUTO_ASSIGN=0.85
